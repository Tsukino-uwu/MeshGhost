# Build output
/dist/
*.exe
*.dll
*.so
*.dylib
# Windows version resources, generated by release.yml from cmd/*/winres/winres.json.
*.syso

# The Linux and macOS binaries have no extension, so *.exe misses them, and a local dry run leaves them inside a
# tracked directory.
/stage/
/packaging/release/meshghost-linux-*
/packaging/release/meshghost-macos-*
/packaging/release/meshghost-server-linux-*
/packaging/release/meshghost-server-macos-*

# LuaSocket is a vendored dependency of the Emerald adapter, not build output.
!/adapters/emulator/pokemon/emerald/lib/**/*.dll

# Probe logs, control files and screenshots, in every adapter: personal diagnostic output that grows without bound.
# The probes themselves are committed.
/adapters/**/*.log
/adapters/**/*.cmd
/adapters/**/*.png
# An adapter's own shipped art is content, not diagnostic output.
!/adapters/**/assets/*.png
# The Emerald adapter's per-machine cross-map scan cache (a ROM-keyed address).
/adapters/**/xmap_cache.txt

# The Pokemon adapter scripts and lib/ are copied in by the release or a local dry run, never committed: a second
# copy would drift. The README.txt beside them is ours and committed.
/packaging/release/games/pokemon/emerald/meshghost_emerald.lua
/packaging/release/games/pokemon/emerald/lib/

/packaging/release/games/pokemon/crystal/meshghost_crystal.lua
/packaging/release/games/pokemon/crystal/lib/

# The per-game config.json the staging step cuts from the root config.json: a committed copy would drift.
/packaging/release/games/tevi/config.json
/packaging/release/games/pseudoregalia/config.json
# Where TEVI's and Pseudoregalia's sat before the mods read the game root's; kept so a stale dry run shows nothing.
/packaging/release/games/tevi/MeshGhost/config.json
/packaging/release/games/pseudoregalia/pseudoregalia/Binaries/Win64/ue4ss/Mods/MeshGhostPseudo/config.json
# Beside each Pokemon adapter script.
/packaging/release/games/pokemon/emerald/config.json
/packaging/release/games/pokemon/crystal/config.json

# The Pokemon scripts log beside themselves, so a test session in a staged release writes into a tracked directory.
/packaging/release/games/pokemon/*/meshghost_*.log
/packaging/release/games/pokemon/*/xmap_cache.txt

# ap_try.flag runs the Crystal adapter on an unconfirmed Archipelago address: a local experiment, never shipped.
# Globbed so the parked ap_try.flag.off is covered too; the staging check matches only the exact name.
/adapters/emulator/pokemon/crystal/ap_try.flag*

# The TEVI DLL is committed on purpose: CI cannot build it without the game's own DLLs, and release.yml's staleness
# gate checks it. Under MeshGhost/ so that folder is one drag-and-drop into BepInEx/plugins/.
!/packaging/release/games/tevi/MeshGhost/MeshGhostTevi.dll

# The Pseudoregalia DLL is committed on purpose: CI lacks the private UEPseudo submodule and a local UE4SS.
!/packaging/release/games/pseudoregalia/pseudoregalia/Binaries/Win64/ue4ss/Mods/MeshGhostPseudo/dlls/main.dll

# The UE4SS runtime is bundled on purpose, built from the pinned RE-UE4SS submodule; release.yml checks the pin.
!/packaging/release/games/pseudoregalia/pseudoregalia/Binaries/Win64/dwmapi.dll
!/packaging/release/games/pseudoregalia/pseudoregalia/Binaries/Win64/ue4ss/UE4SS.dll

# Go
/vendor/

# .NET build output; files under obj/ embed absolute machine-specific paths.
bin/
obj/

# CMake build tree: generated files and every dependency's build output.
/adapters/pseudoregalia/MeshGhostPseudo/build/

# Dev-run logs: the client's meshghost.log, in its working directory, and the relay's meshghost-server.log, beside its
# config or executable; core.log and relay.log are older names.
core.log
relay.log
meshghost.log
meshghost-server.log
# Globbed for the generation the 1 MiB rotation leaves.
meshghost.log*
meshghost-server.log*
core.log*
relay.log*
# Redirected output of the scaffolding a live test starts, named per run rather than by the binary.
*-live.log
*-live.err.log
*-live.err2.log

# Backups left when a running .exe could not be overwritten in place; *.exe does not match the trailing ~.
*~

# OS cruft
.DS_Store
Thumbs.db

# Editor/tooling local settings
.claude/settings.local.json

# Per-machine agent-harness state, listed here rather than in .git/info/exclude so a fresh clone is covered too.
# Enumerated, not .claude/ wholesale, so shared agent config such as a skill stays committable.
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/agent-registry.json
.claude/agent-memory-local/
.claude/assistant-daemon-state.json
.claude/first-run
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/

# Per-machine BizHawk launchers with real local paths; the tracked .bat files stay generic. They set the bridge
# port, which a second instance started by double-clicking EmuHawk silently shares with the first.
dev-scripts/*.local.bat

# Emulator saves/states (never commit ROMs or save data)
*.sav
*.state
*.srm
*.rom
*.gba

# Local dev/test process logs (relay/core started for a live session)
core-*.log
core-*.err.log
relay-*.log
relay-*.err.log

# A core reads config.json from its working directory, dev-scripts/ under the dev loader, so a stray here silently
# redirects a session's core to another relay.
dev-scripts/config.json

# A core an adapter spawns reads the repo root's config.json, a developer's rig settings; the shipped one is
# packaging/release/config.json.
/config.json

# BizHawk dev loader control files, one per instance in a two-game session.
dev-scripts/bizhawk-dev-loader.target
dev-scripts/bizhawk-dev-loader*.target

# Debugging screenshots, one folder per game, and script logs: a working aid, never project content or evidence.
/dev-scripts/shots/
/dev-scripts/*.png
/dev-scripts/*.log

# autoplay (dev-only): session logs and savestate caches. A savestate carries game data and never enters the repo.
/autoplay/runs/
/autoplay/states/
# The adapters block's patterns, with its assets/ exception, for anything written beside a driver.
/autoplay/**/*.log
/autoplay/**/*.cmd
/autoplay/**/*.png
!/autoplay/**/assets/*.png

# A core config beside an adapter is a dev artifact (it changes -interp on a running session); the release config
# lives in packaging/.
adapters/**/config.json

# Session and build logs go to dev-logs/, and the root globs catch a stray. The folder's README is tracked so the
# folder exists: probes open their logs with io.open(..., "a"), and BizHawk's Lua cannot create a directory.
/dev-logs/*
!/dev-logs/README.md
/build-*.log
/build-*.err.log
/fake-*.log
/netsim-*.log
# The undashed shape, which the relay-<run> patterns miss.
/relay.err.log
/core.err.log

# Written by VS Code extensions; the CMake one stamps this clone's absolute path into it.
.vscode/

# A session working checklist, local only.
REVIEW-FINDINGS.md

# Scratch plans, local only: written to be built and deleted. When the folder goes, so must the pointer to it in
# the Vision item of agent_docs' status page.
/agent_docs/plans/

# A relay's identity (private/server.key is a private key: whoever has it is that relay) and a client's known-servers
# file, both per-install state a local run would otherwise leave inside a tracked directory.
private/
known_servers.json

# docs/ restaged as .txt by dev-scripts/stage-release.ps1; the README.txt beside it is committed.
/packaging/release/docs/

# The full output of the last run-gotests run, so a flake that happens once leaves its test name behind.
gotests-last.log
gotests-race-last.log
gotests-udp-last.log
