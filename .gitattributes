# release.yml's staleness gates hash these on a Windows runner, whose checkout would otherwise write CRLF and fail them.
adapters/tevi/MeshGhostTevi/*.cs text eol=lf
adapters/tevi/MeshGhostTevi/*.csproj text eol=lf
adapters/tevi/MeshGhostTevi/packages.lock.json text eol=lf
global.json text eol=lf
Directory.Build.props text eol=lf
nuget.config text eol=lf
# Pinned with the adapter it compiles by link, so the two agree on a Linux runner.
adapters/tevi/MeshGhostTevi.Tests/*.cs text eol=lf
adapters/tevi/MeshGhostTevi.Tests/*.csproj text eol=lf
# The harness compiles PeerJson.hpp on a Linux runner, so it is pinned LF with the adapter it tests.
adapters/pseudoregalia/MeshGhostPseudo.Tests/*.cpp text eol=lf
adapters/pseudoregalia/MeshGhostPseudo/Mod/src/*.cpp text eol=lf
adapters/pseudoregalia/MeshGhostPseudo/Mod/src/*.hpp text eol=lf
adapters/pseudoregalia/MeshGhostPseudo/Mod/CMakeLists.txt text eol=lf

# A CRLF shell script fails on Linux with "$'\r': command not found", while Git Bash here runs it fine.
*.sh text eol=lf

# go mod tidy rewrites these as LF, so a CRLF copy turns a routine tidy into a whole-file diff.
go.mod text eol=lf
go.sum text eol=lf

# Under core.autocrlf=true a revert writes CRLF, which gofmt -l reports as a whole-file diff while git diff is empty.
*.go text eol=lf

# The hooks are shell scripts without .sh; a CRLF one dies on Linux, and the pre-commit leak check silently stops.
.githooks/* text eol=lf

# READMEs a player double-clicks on Windows, where Notepad shows bare LF as one line; only our own, as vendored UE4SS
# files stay byte-identical. `**`: a gitattributes `*` does not cross a `/`; confirm with `git check-attr eol`.
packaging/release/README.txt text eol=crlf
packaging/release/games/**/README.txt text eol=crlf

# Renamed into the tarballs as README.txt, where a stray CR shows as ^M in a terminal pager.
packaging/unix/README-*.txt text eol=lf

# Ships to all three packages from one blob; LF because encoding/json ignores it and the tarballs are where it shows.
packaging/release/config.json text eol=lf

# cmd.exe mis-parses labels and goto in an LF-only .bat; pinned for every .bat, not only those using goto today.
*.bat text eol=crlf

