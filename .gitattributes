# .github/workflows/release.yml's TEVI staleness gate hashes these files with PowerShell's
# Get-FileHash on a windows-latest runner, and compares against hashes dev-scripts/build-tevi.bat
# computed locally. GitHub's windows-latest runners default to core.autocrlf=true, so without
# this, actions/checkout silently rewrites these LF-committed files to CRLF, changing their
# hash and permanently failing the gate regardless of whether the DLL is actually stale.
adapters/tevi/MeshGhostTevi/*.cs text eol=lf
adapters/tevi/MeshGhostTevi/*.csproj text eol=lf
