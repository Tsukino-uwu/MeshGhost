<?xml version="1.0" encoding="utf-8"?>
<!--
  Same two feeds as adapters/tevi/MeshGhostTevi/nuget.config, which says why: BepInEx.Core and
  UnityEngine.Modules aren't on nuget.org, they come from the feed the BepInEx project publishes to.
  Without this file, restore looks only on nuget.org and fails with NU1101 (2026-09-22).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
