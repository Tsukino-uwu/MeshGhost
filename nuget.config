<?xml version="1.0" encoding="utf-8"?>
<!--
  Every .csproj in this repo restores from these two feeds. BepInEx.Core and UnityEngine.Modules
  aren't on nuget.org; nuget.bepinex.dev is the feed the BepInEx project itself publishes to, the
  same source BlackSoulKnight/Tevi_Randomizer's own .csproj uses against this same game
  (agent_docs/licensing.md). One file here rather than one per project: NuGet reads nuget.config
  walking up from the project's folder, so a project without its own copy failed with NU1101
  "Unable to find package BepInEx.Core" (the autoplay driver and the dev cheats, 2026-09-22).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
