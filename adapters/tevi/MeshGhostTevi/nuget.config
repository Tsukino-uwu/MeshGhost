<?xml version="1.0" encoding="utf-8"?>
<!--
  BepInEx.Core and UnityEngine.Modules aren't on nuget.org; bepinex.dev is the feed the BepInEx
  project itself publishes to, and it's the source BlackSoulKnight/Tevi_Randomizer's own
  .csproj uses for the same two packages against this same game, see agent_docs/licensing.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
