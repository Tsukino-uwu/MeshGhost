<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 6 (TEVI) BepInEx plugin. netstandard2.0 plus BepInEx/Unity via NuGet is the same
    approach read from BlackSoulKnight/Tevi_Randomizer's own .csproj (MIT-licensed, see
    agent_docs/licensing.md), confirmed working against this exact game.

    lib/Assembly-CSharp.dll is a local copy of the user's own TEVI install (gitignored by the
    repo's blanket *.dll rule, never committed), referenced only to compile against TEVI's
    real class/field names (agent_docs/licensing.md's "facts, never code" posture, same as
    pokeemerald). Dated 2026-07-09; see agent_docs/environment.md for the version stamp.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MeshGhostTevi</AssemblyName>
    <RootNamespace>MeshGhostTevi</RootNamespace>
    <!-- BepInEx plugins are loaded straight from a DLL, not published/run as an app. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!--
      A WINDOWS pdb, not the SDK's default "portable" one. This is not a preference: ScriptEngine
      (the hot-reload dev tool, see dev-scripts/tevi-hotreload.ps1) reads the assembly through
      Mono.Cecil WITH SYMBOLS, and Cecil's DefaultSymbolReaderProvider cannot read a portable pdb.
      It throws SymbolsNotFoundException and the plugin silently never loads. Measured live
      2026-08-28: with the portable pdb sitting right beside the DLL, the exception still named
      the DLL as having "no symbol found", which reads like a missing file and is really a
      wrong-format one. The portable pdb was confirmed by its own magic bytes (BSJB).

      Nothing about the shipped DLL changes. Only which debug format is emitted next to it, and
      the pdb is never staged into packaging/release/.
    -->
    <DebugType>full</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 5.4.x, matching this machine's confirmed-working TEVI install
         (agent_docs/environment.md). -->
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <!-- Unity API surface pinned to TEVI's actual confirmed Unity version (2021.3.25f1, read
         directly from UnityPlayer.dll, see agent_docs/environment.md), not the 2021.3.33 the
         randomizer's own project happens to reference. -->
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.25" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Newtonsoft.Json.dll: the game's own copy (Managed\Newtonsoft.Json.dll), not a fresh
         NuGet pull. Private=false so we don't ship a second copy alongside the one Unity/TEVI
         already loads: two different assemblies both named Newtonsoft.Json in the same
         AppDomain is a real, avoidable duplicate-type conflict. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
