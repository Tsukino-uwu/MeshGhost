#!/bin/sh
# Every push: preflight -TreeOnly over each pushed tip, in a worktree of that commit, so what leaves this machine is
# checked rather than the working copy. When the push changes preflight, its harness or the data they read, the
# harness (negative-test-preflight.ps1) runs too, from the same worktree, in six parallel shards.

root=$(git rev-parse --show-toplevel) || exit 1
if [ -x "${SYSTEMROOT:-C:/Windows}/System32/WindowsPowerShell/v1.0/powershell.exe" ]; then
    ps="${SYSTEMROOT:-C:/Windows}/System32/WindowsPowerShell/v1.0/powershell.exe"
elif command -v pwsh >/dev/null 2>&1; then
    ps=$(command -v pwsh)
else
    echo "pre-push: no PowerShell found to run preflight; refusing rather than passing unchecked." >&2
    exit 1
fi
gate='^dev-scripts/(preflight\.ps1|negative-test-preflight\.ps1|phase-map\.txt|gate-lists\.txt)$'
scratch="${TEMP:-${TMPDIR:-/tmp}}/meshghost-prepush-$$"

zero=0000000000000000000000000000000000000000
known=$(git for-each-ref --format='^%(objectname)' refs/remotes)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        new="$local_sha ^$remote_sha"
    else
        new="$local_sha $known"
    fi
    echo "pre-push: preflight over $local_ref ($(git rev-parse --short "$local_sha"))"
    wt="$scratch/tip"
    git worktree add --detach --quiet "$wt" "$local_sha" || { status=1; continue; }
    if ! "$ps" -NoProfile -ExecutionPolicy Bypass -File "$wt/dev-scripts/preflight.ps1" -TreeOnly > "$scratch/preflight.txt" 2>&1; then
        grep -E '^  FAIL|^== ' "$scratch/preflight.txt" | grep -B1 '^  FAIL' >&2
        status=1
    fi
    # shellcheck disable=SC2086
    if git log --format= --name-only $new | grep -qE "$gate"; then
        echo "pre-push: the push changes the gate; running its harness in six shards"
        pids=''
        for i in 1 2 3 4 5 6; do
            "$ps" -NoProfile -ExecutionPolicy Bypass -File "$wt/dev-scripts/negative-test-preflight.ps1" \
                -Shard "$i" -Shards 6 -ScratchRoot "$scratch/shard$i" > "$scratch/harness$i.txt" 2>&1 &
            pids="$pids $!"
        done
        i=0
        for pid in $pids; do
            i=$((i + 1))
            if ! wait "$pid"; then
                grep -E '^== |^  FAIL' "$scratch/harness$i.txt" | grep -B1 '^  FAIL' >&2
                status=1
            fi
        done
    fi
    git worktree remove --force "$wt" >/dev/null 2>&1
done
rm -rf "$scratch"
git worktree prune
[ $status -ne 0 ] && echo "pre-push: refused; fix what preflight names above, then push again." >&2
exit $status
